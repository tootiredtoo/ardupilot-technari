<?xml version="1.0" ?>
<!--
  Gazebo Classic world: GR-008 catapult launch scenario.

  The plane is spawned at 12.3° nose-up pitch on a flat launch pad,
  matching the catapult rail angle used in real flight operations.

  To launch with ArduPilot SITL:

    # Terminal 1 — start Gazebo
    gazebo --verbose Tools/simulation/gazebo/worlds/gr008_catapult.world

    # Terminal 2 — start ArduPlane SITL (in the repo root)
    ./build/sitl/bin/arduplane \
        --model gazebo-plane \
        --home 51.0,0.0,0,352 \
        --serial0 tcp:5760

    # Terminal 3 — GCS (MAVProxy / Mission Planner / QGC)
    mavproxy.py --master tcp:127.0.0.1:5760

  Note: Gazebo + ArduPilot communicate on UDP 9002/9003 (localhost).
  No real-time speedup is possible in Gazebo Classic; it runs at ~1×.
-->
<sdf version="1.7">
<world name="gr008_catapult">

  <!-- Sun lighting -->
  <include>
    <uri>model://sun</uri>
  </include>

  <!-- Ground plane -->
  <include>
    <uri>model://ground_plane</uri>
  </include>

  <!-- Physics: ODE with 500 Hz internal step, 1 ms max step time -->
  <physics type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
    <ode>
      <solver>
        <type>quick</type>
        <iters>100</iters>
        <sor>1.3</sor>
      </solver>
      <constraints>
        <cfm>0</cfm>
        <erp>0.2</erp>
        <contact_max_correcting_vel>100</contact_max_correcting_vel>
        <contact_surface_layer>0.001</contact_surface_layer>
      </constraints>
    </ode>
  </physics>

  <!-- Atmosphere -->
  <atmosphere type="adiabatic"/>
  <wind>
    <linear_velocity>0 0 0</linear_velocity>
  </wind>

  <!-- Spherical coordinates: same origin as ArduPilot --home 51.0,0.0,0,352 -->
  <spherical_coordinates>
    <surface_model>EARTH_WGS84</surface_model>
    <latitude_deg>51.0</latitude_deg>
    <longitude_deg>0.0</longitude_deg>
    <elevation>0</elevation>
    <heading_deg>180</heading_deg>
  </spherical_coordinates>

  <!-- GR-008 on catapult rail: 12.3° nose-up, 0.5 m above ground -->
  <!-- pose: x y z roll pitch yaw  (pitch positive = nose up)      -->
  <model name="gr008_plane">
    <include>
      <uri>model://gr008_plane</uri>
    </include>
    <pose>0 0 0.5 0 0.21467 0</pose>
  </model>

</world>
</sdf>
